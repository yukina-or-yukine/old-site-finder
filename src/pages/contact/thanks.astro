---
import BaseLayout from "../../layouts/BaseLayout.astro";
import SubPageHeader from "../../components/SubPageHeader.astro";
import SiteFooter from "../../components/SiteFooter.astro";
---
<BaseLayout title="送信完了 | 飛兎竜文堂">
  <div class="stage">
    <SubPageHeader />

    <div class="thanks__page">
      <div class="ornament thanks__head">
        <span class="en">Thank You</span>
        <span class="jp">送信完了</span>
        <span class="rule"></span>
      </div>

      <div class="thanks__body">
        <p class="thanks__main">お問い合わせありがとうございます。</p>
        <p class="thanks__sub">
          内容を確認のうえ、数日以内にご連絡いたします。
        </p>
        <div class="thanks__actions">
          <a class="ghost-pill" href="/">
            <span>トップページへ戻る</span><span class="arr"></span>
          </a>
        </div>
      </div>
    </div>

    <SiteFooter />
  </div>
</BaseLayout>

<style>
  .thanks__page {
    padding: 120px 60px 160px;
    text-align: center;
  }
  .thanks__head {
    margin-bottom: 64px;
  }
  .thanks__body {
    max-width: 560px;
    margin: 0 auto;
  }
  .thanks__main {
    font-family: var(--serif);
    font-weight: 400;
    font-size: 26px;
    letter-spacing: .14em;
    color: var(--ink);
    margin: 0 0 20px;
  }
  .thanks__sub {
    font-size: 15px;
    line-height: 2.1;
    color: var(--ink-soft);
    letter-spacing: .06em;
    margin: 0 0 56px;
  }
  .thanks__actions {
    display: flex;
    justify-content: center;
  }

  @media (max-width: 768px) {
    .thanks__page { padding: 80px 24px 120px; }
    .thanks__head { margin-bottom: 48px; }
    .thanks__main { font-size: 22px; }
  }
  @media (max-width: 640px) {
    .thanks__page { padding: 60px 16px 96px; }
    .thanks__main { font-size: 20px; }
    .thanks__sub { font-size: 14px; margin-bottom: 44px; }
  }
</style>
