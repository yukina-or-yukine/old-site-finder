---
import type { CollectionEntry } from "astro:content";

interface Props {
  categories: string[];
  rankedPosts: CollectionEntry<"column">[];
  currentCategory?: string;
  mode: "filter" | "link";
}

const { categories, rankedPosts, currentCategory, mode } = Astro.props;
const slugOf = (id: string) => id.replace(/\.[^.]+$/, "");
---

<div class="cs">
  {rankedPosts.length > 0 && (
    <div class="sidebar-block">
      <h2 class="sidebar-title">よく読まれている記事</h2>
      <ol class="ranking-list">
        {rankedPosts.map((p, i) => (
          <li class="ranking-item">
            <span class="rank-num">{i + 1}</span>
            <a class="rank-link" href={`/column/${slugOf(p.id)}`}>{p.data.title}</a>
          </li>
        ))}
      </ol>
    </div>
  )}

  <div class="sidebar-block">
    <h2 class="sidebar-title">カテゴリ</h2>
    <div class="category-btns">
      {mode === "filter" ? (
        <>
          <button class="category-btn is-active" data-category="all">すべて</button>
          {categories.map((cat) => (
            <button class="category-btn" data-category={cat}>{cat}</button>
          ))}
        </>
      ) : (
        <>
          <a class="category-btn category-link" href="/column/">すべて</a>
          {categories.map((cat) => (
            <a
              class:list={["category-btn", "category-link", currentCategory === cat && "is-active"]}
              href={`/column/?category=${encodeURIComponent(cat)}`}
            >{cat}</a>
          ))}
        </>
      )}
    </div>
  </div>
</div>

<style>
  .cs {
    display: flex;
    flex-direction: column;
    gap: 40px;
  }
  .sidebar-block {
    border-top: 1px solid var(--rule-soft);
    padding-top: 24px;
  }
  .sidebar-title {
    font-family: var(--latin);
    font-weight: 400;
    font-size: 11px;
    letter-spacing: .32em;
    color: var(--gold);
    text-transform: uppercase;
    margin: 0 0 18px;
  }
  .ranking-list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 14px;
  }
  .ranking-item {
    display: flex;
    align-items: flex-start;
    gap: 12px;
  }
  .rank-num {
    font-family: var(--latin);
    font-weight: 400;
    font-size: 16px;
    letter-spacing: .1em;
    color: var(--gold);
    line-height: 1.6;
    flex-shrink: 0;
    min-width: 14px;
  }
  .rank-link {
    font-family: var(--serif);
    font-weight: 400;
    font-size: 14px;
    line-height: 1.75;
    letter-spacing: .06em;
    color: var(--ink);
    transition: color .25s;
  }
  .rank-link:hover { color: var(--gold); }
  .category-btns {
    display: flex;
    flex-direction: column;
    gap: 8px;
  }
  .category-btn {
    display: block;
    width: 100%;
    text-align: left;
    background: none;
    border: 1px solid var(--rule);
    padding: 9px 14px;
    font-family: var(--serif);
    font-weight: 400;
    font-size: 13px;
    letter-spacing: .12em;
    color: var(--ink-soft);
    cursor: pointer;
    transition: background .2s, color .2s, border-color .2s;
    text-decoration: none;
  }
  .category-btn:hover,
  .category-btn.is-active {
    background: var(--ink);
    color: var(--paper);
    border-color: var(--ink);
  }
</style>
