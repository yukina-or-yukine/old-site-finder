---
import BaseLayout from "../../layouts/BaseLayout.astro";
import TopBar from "../../components/TopBar.astro";
import StickyHeader from "../../components/StickyHeader.astro";
import SiteFooter from "../../components/SiteFooter.astro";
import CaseModal from "../../components/CaseModal.astro";
import { getCollection } from "astro:content";

const allCases = await getCollection("cases", ({ data }) => !data.draft);
const sorted = allCases.sort((a, b) => (a.data.order ?? 99) - (b.data.order ?? 99));
---

<BaseLayout title="鑑定事例 一覧 | 飛兎竜文堂">
  <StickyHeader />
  <div class="stage">
    <TopBar />

    <section class="cases-list">
      <div class="cases-head cases-list__head">
        <div class="title-block">
          <span class="en">Appraisal Case</span>
          <span class="jp">鑑定事例</span>
        </div>
      </div>

      <div class="cases-list__grid" id="cases-list-grid">
        {sorted.map((c, i) => (
          <article
            class="case-card cases__card cases-list__card"
            data-case-id={c.id}
            data-idx={i}
            role="button"
            tabindex="0"
            aria-haspopup="dialog"
          >
            <div class="case-thumb cases__thumb">
              {c.data.image
                ? <img src={c.data.image} alt={c.data.title} />
                : (
                  <svg viewBox="0 0 64 64" fill="none" stroke="currentColor" stroke-width="1.2">
                    <circle cx="32" cy="26" r="10"/>
                    <path d="M18 52c1.5-8 6-13 14-13s12.5 5 14 13"/>
                    <circle cx="48" cy="14" r="4" opacity=".4"/>
                    <path d="M4 32h4M56 32h4M32 4v4M32 56v4" stroke-linecap="round"/>
                  </svg>
                )
              }
            </div>
            <h3 class="case-title">{c.data.title}</h3>
            <div class="case-meta">
              <div class="tags">
                <span class="tag">{c.data.age}</span>
                <span class="tag">{c.data.gender}</span>
                <span class="tag">{c.data.area}</span>
              </div>
              <span class="more">More</span>
            </div>
          </article>
        ))}
      </div>

      <nav
        class="cases-list__pager"
        id="cases-list-pager"
        aria-label="ページナビゲーション"
      ></nav>
    </section>

    <SiteFooter />
  </div>
</BaseLayout>

<CaseModal cases={sorted} />

<script>
  const PER_PAGE = 20;
  const allCards  = Array.from(document.querySelectorAll('.cases-list__card'));
  const totalPages = Math.max(1, Math.ceil(allCards.length / PER_PAGE));

  function getPage() {
    const p = parseInt(new URLSearchParams(location.search).get('page') ?? '1', 10);
    return isNaN(p) || p < 1 ? 1 : Math.min(p, totalPages);
  }

  function showPage(page) {
    const start = (page - 1) * PER_PAGE;
    const end   = start + PER_PAGE;
    allCards.forEach((card, i) => {
      card.hidden = i < start || i >= end;
    });
    renderPager(page);
  }

  function renderPager(page) {
    const pager = document.getElementById('cases-list-pager');
    if (!pager || totalPages <= 1) return;

    let html = '';

    if (page > 1) {
      html += `<a href="?page=${page - 1}" class="pager__btn pager__prev">← 前へ</a>`;
    } else {
      html += `<span class="pager__btn pager__prev is-disabled">← 前へ</span>`;
    }

    for (let p = 1; p <= totalPages; p++) {
      const cur = p === page ? ' is-current' : '';
      html += `<a href="?page=${p}" class="pager__num${cur}">${p}</a>`;
    }

    if (page < totalPages) {
      html += `<a href="?page=${page + 1}" class="pager__btn pager__next">次へ →</a>`;
    } else {
      html += `<span class="pager__btn pager__next is-disabled">次へ →</span>`;
    }

    pager.innerHTML = html;
  }

  showPage(getPage());
</script>
