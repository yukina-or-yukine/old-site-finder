---
// Hero section with brand rail + image + nav rail
---
<section class="hero">
  <div class="hero-grid">
    <aside class="brand">
      <div class="brand-mark">
        <svg viewBox="0 0 64 64" fill="none">
          <path d="M32 4 L52 24 L32 44 L12 24 Z" stroke="#14110d" stroke-width="1.2" fill="rgba(168,137,92,.12)"></path>
          <path d="M32 20 L52 40 L32 60 L12 40 Z" stroke="#a8895c" stroke-width="1.2"></path>
          <circle cx="32" cy="32" r="2" fill="#a8895c"></circle>
        </svg>
      </div>
      <div class="brand-name-jp">飛兎竜文堂</div>
      <div class="brand-name-en">Hitoryobundo</div>
    </aside>

    <div>
      <div class="hero-image" role="img" aria-label="鑑定の様子"></div>
      <div class="hero-text-block">
        <div class="hero-overline">— Divination &amp; Counsel —</div>
        <h1 class="hero-headline" style="width: 780px">
          <span class="em">星と数</span>に問い、<br>
          あなたの<span class="em">行く道</span>をひらく。
        </h1>
        <p class="hero-sub">
          親譲りの直感と古典の占技をあわせ、暮らしの選択をやさしく整える。<br>
          北摂より、ひとりひとりの結び目をほどくお手伝いを。
        </p>
      </div>
    </div>

    <aside class="nav-rail" aria-label="主要メニュー">
      <a href="#service">
        <span class="ic"><svg viewBox="0 0 24 24"><path d="M12 21s-7-4.5-9-9a5 5 0 019-3 5 5 0 019 3c-2 4.5-9 9-9 9z" stroke-linejoin="round"></path></svg></span>
        <span class="lbl">サービス</span>
      </a>
      <a href="#cases">
        <span class="ic"><svg viewBox="0 0 24 24"><circle cx="9" cy="9" r="3.2"></circle><circle cx="16.5" cy="10" r="2.5"></circle><path d="M3 19c.8-3.4 3-5 6-5s5.2 1.6 6 5M14 19c.6-2.5 2-4 4.5-4S22.5 16.2 23 19" stroke-linecap="round"></path></svg></span>
        <span class="lbl">鑑定事例</span>
      </a>
      <a href="#profile">
        <span class="ic"><svg viewBox="0 0 24 24"><circle cx="12" cy="8" r="4"></circle><path d="M4 21c0-4.4 3.6-7 8-7s8 2.6 8 7"></path></svg></span>
        <span class="lbl">プロフィール</span>
      </a>
      <a href="#column">
        <span class="ic"><svg viewBox="0 0 24 24"><path d="M5 4h9a4 4 0 014 4v12H8a3 3 0 01-3-3V4z"></path><path d="M5 17a3 3 0 013-3h10"></path></svg></span>
        <span class="lbl">〇〇コラム</span>
      </a>
    </aside>
  </div>
</section>
