---
// Top sticky scroll header
---
<div class="sticky-header" id="stickyHeader" aria-hidden="true">
  <a class="sh-brand" href="#top">
    <svg viewBox="0 0 64 64" fill="none">
      <path d="M32 4 L52 24 L32 44 L12 24 Z" stroke="#14110d" stroke-width="1.6" fill="rgba(168,137,92,.12)"></path>
      <path d="M32 20 L52 40 L32 60 L12 40 Z" stroke="#a8895c" stroke-width="1.6"></path>
      <circle cx="32" cy="32" r="2" fill="#a8895c"></circle>
    </svg>
    <span class="nm">飛兎竜文堂</span>
    <span class="read">Hitoryobundo</span>
  </a>
  <nav class="sh-nav" aria-label="主要メニュー">
    <a href="#service"><span class="en">Service</span><span>サービス</span></a>
    <a href="#cases"><span class="en">Case</span><span>鑑定事例</span></a>
    <a href="#profile"><span class="en">Profile</span><span>プロフィール</span></a>
    <a href="#column"><span class="en">Column</span><span>〇〇コラム</span></a>
  </nav>
  <div class="sh-right">
    <nav class="sns" aria-label="SNS">
      <a href="#" aria-label="Instagram"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><rect x="3" y="3" width="18" height="18" rx="5"></rect><circle cx="12" cy="12" r="4"></circle><circle cx="17.5" cy="6.5" r=".8" fill="currentColor"></circle></svg></a>
      <a href="#" aria-label="X"><svg viewBox="0 0 24 24" fill="currentColor"><path d="M18 3h3l-7.5 8.6L22 21h-6.8l-5.3-6.7L3.7 21H.7l8-9.2L0 3h7l4.8 6.2L18 3z"></path></svg></a>
    </nav>
    <a class="sh-cta" href="#contact"><span class="dot"></span>予約・お問い合わせ</a>
  </div>
</div>

<script is:inline>
  (function(){
    var sh = document.getElementById('stickyHeader');
    if(!sh) return;
    var SHOW_AT = 240;
    var HIDE_AT = 120;
    var visible = false;
    function onScroll(){
      var y = window.scrollY || window.pageYOffset;
      if(!visible && y > SHOW_AT){ sh.classList.add('is-visible'); sh.setAttribute('aria-hidden','false'); visible = true; }
      else if(visible && y < HIDE_AT){ sh.classList.remove('is-visible'); sh.setAttribute('aria-hidden','true'); visible = false; }
    }
    window.addEventListener('scroll', onScroll, {passive:true});
    onScroll();
  })();
</script>
