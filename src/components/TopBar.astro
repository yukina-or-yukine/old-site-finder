---
// Top bar (announcement + SNS + CTA)
---
<header class="topbar">
  <div class="tag">北摂で様々な占技を用いて人生をよりよくする占いをしています</div>

  <nav class="topbar-nav" id="topbar-nav" aria-label="メインナビゲーション">
    <a href="#service"><span class="ic"><img src="/images/service-icon.svg" alt="" width="108" height="auto"></span><span class="lbl">サービス</span></a>
    <a href="#cases"><span class="ic"><img src="/images/case-icon.svg" alt="" width="116" height="auto"></span><span class="lbl">鑑定事例</span></a>
    <a href="#profile"><span class="ic"><img src="/images/yukine-icon.svg" alt="" width="72" height="auto"></span><span class="lbl">プロフィール</span></a>
    <a href="#column"><span class="ic"><img src="/images/column-icon.svg" alt="" width="64" height="auto"></span><span class="lbl">コラム</span></a>
  </nav>

  <div class="right">
    <button class="hamburger" id="hamburger" aria-label="メニューを開く" aria-expanded="false" aria-controls="topbar-nav">☰</button>
    <nav class="sns" aria-label="SNS">
      <a href="#" aria-label="Instagram"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><rect x="3" y="3" width="18" height="18" rx="5"></rect><circle cx="12" cy="12" r="4"></circle><circle cx="17.5" cy="6.5" r=".8" fill="currentColor"></circle></svg></a>
      <a href="#" aria-label="note"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><circle cx="12" cy="12" r="9.5"></circle><path d="M8 8.5v7M8 8.5l8 7M16 8.5v7" stroke-linecap="round"></path></svg></a>
    </nav>
    <a class="cta-pill" href="/contact/"><span class="dot"></span>ご相談はこちらから</a>
  </div>
</header>

<script>
  const hamburger = document.getElementById('hamburger');
  const nav = document.getElementById('topbar-nav');

  hamburger?.addEventListener('click', () => {
    const open = nav?.classList.toggle('is-open');
    hamburger.setAttribute('aria-expanded', String(!!open));
    hamburger.setAttribute('aria-label', open ? 'メニューを閉じる' : 'メニューを開く');
  });
</script>
