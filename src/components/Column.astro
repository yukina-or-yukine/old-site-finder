---
import { getCollection } from "astro:content";

const allPosts = await getCollection("column", ({ data }) => !data.draft);
const columns = allPosts
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())
  .slice(0, 6);

const fmt = (d: Date) =>
  [d.getFullYear(), String(d.getMonth() + 1).padStart(2, "0"), String(d.getDate()).padStart(2, "0")].join(".");

const slugOf = (id: string) => id.replace(/\.[^.]+$/, "");
---
<section class="column" id="column">
  <div class="ornament">
    <span class="en">Column</span>
    <span class="jp">読みもの</span>
    <span class="rule"></span>
  </div>

  <div class="column-grid">
    {columns.map((post) => (
      <a class="col-card" href={`/column/${slugOf(post.id)}`}>
        <div
          class="col-thumb"
          style="background-image:url(/images/hero.jpg)"
        ></div>
        <div class="col-meta">
          <span class="col-date">{fmt(post.data.date)}</span>
          <span class="col-cat">{post.data.category}</span>
        </div>
        <h3 class="col-title">{post.data.title}</h3>
      </a>
    ))}
  </div>

  <div class="col-actions">
    <a class="ghost-pill" href="/column"><span>コラム一覧へ</span><span class="arr"></span></a>
  </div>
</section>
