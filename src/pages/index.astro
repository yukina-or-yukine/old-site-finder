---
import BaseLayout from "../layouts/BaseLayout.astro";
import StickyHeader from "../components/StickyHeader.astro";
import TopBar from "../components/TopBar.astro";
import Hero from "../components/Hero.astro";
import ServiceIntro from "../components/ServiceIntro.astro";
import Cases from "../components/Cases.astro";
import Profile from "../components/Profile.astro";
import Column from "../components/Column.astro";
import CtaBand from "../components/CtaBand.astro";
import Banners from "../components/Banners.astro";
import SiteFooter from "../components/SiteFooter.astro";
---
<BaseLayout>
  <StickyHeader />
  <div class="stage" data-screen-label="01 Top" id="top">
    <TopBar />
    <Hero />
    <ServiceIntro />
    <Cases />
    <Profile />
    <Column />
    <CtaBand />
    <Banners />
    <SiteFooter />
  </div>
</BaseLayout>
